@article{perez-seguraChangingFaceSocioeconomic2023,
  title = {Changing Face of Socio-Economic Vulnerability and {{COVID-19}}: {{An}} Analysis of Country Wealth during the First Two Years of the Pandemic},
  shorttitle = {Changing Face of Socio-Economic Vulnerability and {{COVID-19}}},
  author = {Pérez-Segura, Víctor and Caro-Carretero, Raquel and Rua, Antonio},
  editor = {Rafael, Ricardo De Mattos Russo},
  date = {2023-08-28},
  journaltitle = {PLOS ONE},
  shortjournal = {PLoS ONE},
  volume = {18},
  number = {8},
  pages = {e0290529},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0290529},
  url = {https://dx.plos.org/10.1371/journal.pone.0290529},
  urldate = {2026-06-12},
  abstract = {There are numerous academic studies on the relationship between population wealth and the incidence of COVID-19. However, research developed shows contradictory results on their relationship. In accordance with this question, this work pursues two objectives: on the one hand, to check whether wealth and disease incidence have a unidirectional and stable relationship. And on the other hand, to find out if the country’s statistical production capacity is masking the real incidence of the COVID-19 pandemic. In order to achieve this objective, an ecological study has been designed at international level with the countries established as study units. The analytical strategy utilized involves the consecutive application of cross-sectional analysis, specifically employing multivariate linear regression daily throughout the first two years of the pandemic (from 03/14/2020 to 03/28/2022). The application of multiple cross-sectional analysis has shown that country wealth has a dynamic relationship with the incidence of COVID-19. Initially, it appears as a risk factor and, in the long term, as a protective element. In turn, statistical capacity appears as an explanatory variable for the number of published COVID-19 cases and deaths. Therefore, the inadequate statistical production capacity of low income countries may be masking the real incidence of the disease.},
  langid = {english},
  file = {C:\Users\Hp\Zotero\storage\76GCGUDG\Pérez-Segura et al. - 2023 - Changing face of socio-economic vulnerability and COVID-19 An analysis of country wealth during the.pdf}
}

@article{pickettMultilevelAnalysesNeighbourhood2001,
  title = {Multilevel Analyses of Neighbourhood Socioeconomic Context and Health Outcomes: A Critical Review: {{Table}} 1},
  shorttitle = {Multilevel Analyses of Neighbourhood Socioeconomic Context and Health Outcomes},
  author = {Pickett, K E and Pearl, M},
  date = {2001-02-01},
  journaltitle = {Journal of Epidemiology and Community Health},
  shortjournal = {J Epidemiol Community Health},
  volume = {55},
  number = {2},
  pages = {111--122},
  issn = {0143-005X, 1470-2738},
  doi = {10.1136/jech.55.2.111},
  url = {https://jech.bmj.com/lookup/doi/10.1136/jech.55.2.111},
  urldate = {2026-06-12},
  abstract = {PURPOSE               Interest in the effects of neighbourhood or local area social characteristics on health has increased in recent years, but to date the existing evidence has not been systematically reviewed. Multilevel or contextual analyses of social factors and health represent a possible reconciliation between two divergent epidemiological paradigms—individual risk factor epidemiology and an ecological approach.                                         DATA SOURCES               Keyword searching of Index Medicus (Medline) and additional references from retrieved articles.                                         STUDY SELECTION               All original studies of the effect of local area social characteristics on individual health outcomes, adjusted for individual socioeconomic status, published in English before 1 June 1998 and focused on populations in developed countries.                                         DATA SYNTHESIS               The methodological challenges posed by the design and interpretation of multilevel studies of local area effects are discussed and results summarised with reference to type of health outcome. All but two of the 25 reviewed studies reported a statistically significant association between at least one measure of social environment and a health outcome (contextual effect), after adjusting for individual level socioeconomic status (compositional effect). Contextual effects were generally modest and much smaller than compositional effects.                                         CONCLUSIONS               The evidence for modest neighbourhood effects on health is fairly consistent despite heterogeneity of study designs, substitution of local area measures for neighbourhood measures and probable measurement error. By drawing public health attention to the health risks associated with the social structure and ecology of neighbourhoods, innovative approaches to community level interventions may ensue.},
  langid = {english}
}

